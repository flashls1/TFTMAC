+MVKPipelineCache* MVKDevice::getOrCreateDefaultPipelineCache() {
+	std::lock_guard<std::mutex> lock(_defaultPipelineCacheLock);
+	if (_defaultPipelineCache) {
+		return _defaultPipelineCache;
+	}
+
+	const char* envPath = getenv("TFTMAC_MVK_PIPELINE_CACHE_PATH");
+	if (!envPath || !*envPath) {
+		envPath = "/Volumes/MAC MINI M4/TFTMAC/Diagnostics/GraphicsRuntimeV1/Cache/moltenvk_pso.cache";
+	}
+	_persistentPipelineCachePath = envPath;
+
+	std::vector<uint8_t> initialData;
+	FILE* file = fopen(_persistentPipelineCachePath.c_str(), "rb");
+	if (file) {
+		fseek(file, 0, SEEK_END);
+		long fileSize = ftell(file);
+		if (fileSize > 0) {
+			fseek(file, 0, SEEK_SET);
+			initialData.resize(static_cast<size_t>(fileSize));
+			size_t bytesRead = fread(initialData.data(), 1, initialData.size(), file);
+			if (bytesRead != initialData.size()) {
+				initialData.clear();
+			}
+		}
+		fclose(file);
+	}
+
+	VkPipelineCacheCreateInfo createInfo{};
+	createInfo.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+	if (!initialData.empty()) {
+		createInfo.initialDataSize = initialData.size();
+		createInfo.pInitialData = initialData.data();
+	}
+
+	_defaultPipelineCache = new MVKPipelineCache(this, &createInfo);
+	MVKLogInfo("TFTMAC: Initialized default persistent pipeline cache from '%s' (%zu bytes loaded).",
+			   _persistentPipelineCachePath.c_str(), initialData.size());
+	return _defaultPipelineCache;
+}
+
+void MVKDevice::saveDefaultPipelineCache() {
+	std::lock_guard<std::mutex> lock(_defaultPipelineCacheLock);
+	if (!_defaultPipelineCache || _persistentPipelineCachePath.empty()) {
+		return;
+	}
+
+	size_t dataSize = 0;
+	VkResult res = _defaultPipelineCache->writeData(&dataSize, nullptr);
+	if (res != VK_SUCCESS || dataSize == 0) {
+		return;
+	}
+
+	std::vector<uint8_t> data(dataSize);
+	res = _defaultPipelineCache->writeData(&dataSize, data.data());
+	if (res != VK_SUCCESS) {
+		return;
+	}
+
+	std::string dir = _persistentPipelineCachePath;
+	size_t lastSlash = dir.find_last_of('/');
+	if (lastSlash != std::string::npos) {
+		dir = dir.substr(0, lastSlash);
+		char cmd[PATH_MAX];
+		snprintf(cmd, sizeof(cmd), "/bin/mkdir -p '%s'", dir.c_str());
+		system(cmd);
+	}
+
+	std::string tmpPath = _persistentPipelineCachePath + ".tmp";
+	FILE* file = fopen(tmpPath.c_str(), "wb");
+	if (file) {
+		fwrite(data.data(), 1, data.size(), file);
+		fclose(file);
+		rename(tmpPath.c_str(), _persistentPipelineCachePath.c_str());
+		MVKLogInfo("TFTMAC: Saved %zu bytes to persistent pipeline cache '%s'.",
+				   data.size(), _persistentPipelineCachePath.c_str());
+	}
+}
+
+void MVKDevice::onPipelineCacheDirty() {
+	if (++_newPipelinesSinceSave >= 25) {
+		_newPipelinesSinceSave = 0;
+		saveDefaultPipelineCache();
+	}
+}
