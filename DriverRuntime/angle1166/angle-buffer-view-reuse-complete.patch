+}
+TEST_P(TextureBufferTestES31, TFTMACFormatChangesOnSameAllocation)
+{
+    ANGLE_SKIP_TEST_IF(!IsGLExtensionEnabled("GL_EXT_texture_buffer"));
+    const char *formats[] = {"usamplerBuffer", "isamplerBuffer", "samplerBuffer"};
+    const GLenum internalFormats[] = {GL_RGBA32UI, GL_RGBA32I, GL_RGBA32F};
+    const GLuint one = 0x3f800000u;
+    const std::array<GLuint, 4> data = {one, 0, 0, one};
+    GLBuffer buffer;
+    GLTexture texture;
+    glBindBuffer(GL_TEXTURE_BUFFER, buffer);
+    glBufferData(GL_TEXTURE_BUFFER, sizeof(data), data.data(), GL_STATIC_DRAW);
+    glBindTexture(GL_TEXTURE_BUFFER, texture);
+    for (size_t iteration = 0; iteration < 6; ++iteration)
+    {
+        const size_t index = iteration % 3;
+        std::stringstream fragment;
+        fragment << "#version 310 es\n#extension GL_EXT_texture_buffer : require\n"
+                 << "precision highp float;\nuniform highp " << formats[index]
+                 << " s;\nout vec4 colorOut;\nvoid main() { vec4 v = vec4(texelFetch(s, 0));"
+                 << "colorOut = (v.r == " << (index == 2 ? "1.0" : "1065353216.0")
+                 << " && v.g == 0.0 && textureSize(s) == 1) ? vec4(1,0,0,1) : vec4(1,0,1,1); }";
+        ANGLE_GL_PROGRAM(program, essl31_shaders::vs::Simple(), fragment.str().c_str());
+        glTexBufferEXT(GL_TEXTURE_BUFFER, internalFormats[index], buffer);
+        drawQuad(program, essl31_shaders::PositionAttrib(), 0.5);
+        EXPECT_PIXEL_COLOR_EQ(0, 0, GLColor::red);
+        EXPECT_GL_NO_ERROR();
+    }
+}
+
+// Identical rebinding must exercise the retained-view branch; pixel correctness
+// alone would also pass if the experimental path never ran.
+TEST_P(TextureBufferTestES31, TFTMACIdenticalBindingsExerciseReuse)
+{
+    ANGLE_SKIP_TEST_IF(!IsVulkan());
+    ANGLE_SKIP_TEST_IF(!IsGLExtensionEnabled("GL_EXT_texture_buffer"));
+    ANGLE_SKIP_TEST_IF(!IsGLExtensionEnabled("GL_AMD_performance_monitor"));
+    constexpr char fragment[] = R"(#version 310 es
+#extension GL_EXT_texture_buffer : require
+precision highp float;
+uniform highp samplerBuffer s;
+out vec4 colorOut;
+void main() { colorOut = texelFetch(s, 0); }
+)";
+    ANGLE_GL_PROGRAM(program, essl31_shaders::vs::Simple(), fragment);
+    GLTexture texture;
+    GLBuffer buffer;
+    const std::array<GLfloat, 4> red = {1, 0, 0, 1};
+    glBindBuffer(GL_TEXTURE_BUFFER, buffer);
+    glBufferData(GL_TEXTURE_BUFFER, sizeof(red), red.data(), GL_STATIC_DRAW);
+    glBindTexture(GL_TEXTURE_BUFFER, texture);
+    glTexBufferEXT(GL_TEXTURE_BUFFER, GL_RGBA32F, buffer);
+    drawQuad(program, essl31_shaders::PositionAttrib(), 0.5);
+    EXPECT_PIXEL_COLOR_EQ(0, 0, GLColor::red);
+    const auto counters = BuildCounterNameToIndexMap();
+    const uint64_t before = GetPerfCounters(counters).tftmacTextureBufferRetainedBindings;
+    for (int index = 0; index < 20; ++index)
+    {
+        glTexBufferEXT(GL_TEXTURE_BUFFER, GL_RGBA32F, buffer);
+        drawQuad(program, essl31_shaders::PositionAttrib(), 0.5);
+    }
+    EXPECT_PIXEL_COLOR_EQ(0, 0, GLColor::red);
+    EXPECT_GL_NO_ERROR();
+    const bool enabled = getEGLWindow()->isFeatureEnabled(Feature::TftmacRetainTextureBufferViews);
+    EXPECT_EQ(GetPerfCounters(counters).tftmacTextureBufferRetainedBindings - before,
+              enabled ? 20u : 0u);
+}
+
+TEST_P(TextureBufferTestES31, TFTMACSharedContextContentStorageAndLifetime)
+{
+    ANGLE_SKIP_TEST_IF(!IsGLExtensionEnabled("GL_EXT_texture_buffer"));
+    constexpr char vertex[] = R"(#version 310 es
+void main() {
+    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+})";
+    constexpr char fragment[] = R"(#version 310 es
+#extension GL_EXT_texture_buffer : require
+precision highp float;
+uniform highp samplerBuffer s;
+out vec4 colorOut;
+void main() { colorOut = texelFetch(s, 0); }
+)";
+    ANGLE_GL_PROGRAM(program, vertex, fragment);
+    GLTexture texture;
+    GLBuffer buffer;
+    const std::array<GLfloat, 4> red = {1, 0, 0, 1};
+    const std::array<GLfloat, 4> green = {0, 1, 0, 1};
+    const std::array<GLfloat, 4> blue = {0, 0, 1, 1};
+    glBindBuffer(GL_TEXTURE_BUFFER, buffer);
+    glBufferData(GL_TEXTURE_BUFFER, sizeof(red), red.data(), GL_DYNAMIC_DRAW);
+    glBindTexture(GL_TEXTURE_BUFFER, texture);
+    glTexBufferEXT(GL_TEXTURE_BUFFER, GL_RGBA32F, buffer);
+    glUseProgram(program);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    GLsync first = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    glFlush();
+
+    EGLWindow *window = getEGLWindow();
+    EGLContext shared = window->createContext(window->getContext(), nullptr);
+    ASSERT_NE(shared, EGL_NO_CONTEXT);
+    struct RestoreContext
+    {
+        EGLWindow *window;
+        EGLContext shared;
+        ~RestoreContext()
+        {
+            window->makeCurrent();
+            eglDestroyContext(window->getDisplay(), shared);
+        }
+    } restore{window, shared};
+    ASSERT_TRUE(window->makeCurrent(shared));
+    glWaitSync(first, 0, GL_TIMEOUT_IGNORED);
+    glDeleteSync(first);
+    glBindBuffer(GL_TEXTURE_BUFFER, buffer);
+    glBufferSubData(GL_TEXTURE_BUFFER, 0, sizeof(green), green.data());
+    glBindTexture(GL_TEXTURE_BUFFER, texture);
+    glTexBufferEXT(GL_TEXTURE_BUFFER, GL_RGBA32F, buffer);
+    glUseProgram(program);
+    glViewport(0, 0, getWindowWidth(), getWindowHeight());
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    EXPECT_PIXEL_COLOR_EQ(0, 0, GLColor::green);
+
+    // Replace the shared allocation while its previous storage has a pending draw.
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glBufferData(GL_TEXTURE_BUFFER, sizeof(blue), blue.data(), GL_DYNAMIC_DRAW);
+    GLsync second = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    glFlush();
+    ASSERT_TRUE(window->makeCurrent());
+    glWaitSync(second, 0, GL_TIMEOUT_IGNORED);
+    glDeleteSync(second);
+    glBindTexture(GL_TEXTURE_BUFFER, texture);
+    glTexBufferEXT(GL_TEXTURE_BUFFER, GL_RGBA32F, buffer);
+    glUseProgram(program);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    EXPECT_PIXEL_COLOR_EQ(0, 0, GLColor::blue);
+    EXPECT_GL_NO_ERROR();
+}
