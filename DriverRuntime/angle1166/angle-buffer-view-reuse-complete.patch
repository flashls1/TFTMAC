+// Exercise content changes separately from binding/storage changes. The same tests run
+// with the experimental Vulkan view-reuse feature both disabled and enabled.
+TEST_P(TextureBufferTestES31, TFTMACContentStorageAndRangeTransitions32Bit)
+{
+    ANGLE_SKIP_TEST_IF(!IsGLExtensionEnabled("GL_EXT_texture_buffer"));
+
+    auto runCase = [&](GLenum format, const char *samplerType, auto scalar, size_t components) {
+        using Scalar = decltype(scalar);
+        const size_t texelBytes = sizeof(Scalar) * components;
+        GLint alignment = 0;
+        glGetIntegerv(GL_TEXTURE_BUFFER_OFFSET_ALIGNMENT, &alignment);
+        ASSERT_GT(alignment, 0);
+        const size_t alignmentBytes = static_cast<size_t>(alignment);
+        const size_t stride = ((texelBytes * 2 + alignmentBytes - 1) / alignmentBytes) * alignmentBytes;
+        std::vector<uint8_t> storage(stride * 2, 0);
+        const std::array<Scalar, 4> red = {1, 0, 0, 1};
+        const std::array<Scalar, 4> green = {0, 1, 0, 1};
+        const std::array<Scalar, 4> blue = {0, 0, 1, 1};
+        memcpy(storage.data(), red.data(), texelBytes);
+        memcpy(storage.data() + stride, blue.data(), texelBytes);
+
+        std::stringstream fragment;
+        fragment << "#version 310 es\n#extension GL_EXT_texture_buffer : require\n"
+                 << "precision highp float;\nuniform highp " << samplerType
+                 << " s;\nuniform int expectedSize;\nout vec4 colorOut;\n"
+                 << "void main() { colorOut = vec4(texelFetch(s, 0)); "
+                 << "if (textureSize(s) != expectedSize) colorOut = vec4(1,0,1,1); }\n";
+        ANGLE_GL_PROGRAM(program, essl31_shaders::vs::Simple(), fragment.str().c_str());
+        glUseProgram(program);
+        glUniform1i(glGetUniformLocation(program, "expectedSize"), 1);
+        GLBuffer buffer;
+        GLTexture texture;
+        glBindBuffer(GL_TEXTURE_BUFFER, buffer);
+        glBufferData(GL_TEXTURE_BUFFER, storage.size(), storage.data(), GL_DYNAMIC_DRAW);
+        glBindTexture(GL_TEXTURE_BUFFER, texture);
+        glTexBufferRangeEXT(GL_TEXTURE_BUFFER, format, buffer, 0, texelBytes);
+
+        auto drawAndCheck = [&](const GLColor &expected) {
+            drawQuad(program, essl31_shaders::PositionAttrib(), 0.5);
+            EXPECT_GL_NO_ERROR();
+            EXPECT_PIXEL_COLOR_EQ(0, 0, expected);
+        };
+        drawAndCheck(GLColor::red);
+        // No glTexBuffer call: update the content of the existing binding.
+        glBufferSubData(GL_TEXTURE_BUFFER, 0, texelBytes, green.data());
+        drawAndCheck(components == 1 ? GLColor::black : GLColor::green);
+
+        // Keep a draw in flight while replacing storage behind the same GL buffer name.
+        drawQuad(program, essl31_shaders::PositionAttrib(), 0.5);
+        glBufferData(GL_TEXTURE_BUFFER, storage.size(), nullptr, GL_DYNAMIC_DRAW);
+        glBufferSubData(GL_TEXTURE_BUFFER, 0, storage.size(), storage.data());
+        drawAndCheck(GLColor::red);
+
+        glTexBufferRangeEXT(GL_TEXTURE_BUFFER, format, buffer, stride, texelBytes);
+        drawAndCheck(components == 4 ? GLColor::blue : GLColor::black);
+        glTexBufferRangeEXT(GL_TEXTURE_BUFFER, format, buffer, 0, texelBytes * 2);
+        glUniform1i(glGetUniformLocation(program, "expectedSize"), 2);
+        drawAndCheck(GLColor::red);
+    };
+
+    runCase(GL_R32F, "samplerBuffer", GLfloat(0), 1);
+    runCase(GL_RG32F, "samplerBuffer", GLfloat(0), 2);
+    runCase(GL_RGBA32F, "samplerBuffer", GLfloat(0), 4);
+    runCase(GL_R32I, "isamplerBuffer", GLint(0), 1);
+    runCase(GL_RG32I, "isamplerBuffer", GLint(0), 2);
+    runCase(GL_RGBA32I, "isamplerBuffer", GLint(0), 4);
+    runCase(GL_R32UI, "usamplerBuffer", GLuint(0), 1);
+    runCase(GL_RG32UI, "usamplerBuffer", GLuint(0), 2);
+    runCase(GL_RGBA32UI, "usamplerBuffer", GLuint(0), 4);
+}
+
+TEST_P(TextureBufferTestES31, TFTMACDestroyTextureAndBufferWhileDrawIsInFlight)
+{
+    ANGLE_SKIP_TEST_IF(!IsGLExtensionEnabled("GL_EXT_texture_buffer"));
+    constexpr char fragment[] = R"(#version 310 es
+#extension GL_EXT_texture_buffer : require
+precision highp float;
+uniform highp samplerBuffer s;
+out vec4 colorOut;
+void main() { colorOut = texelFetch(s, 0); }
