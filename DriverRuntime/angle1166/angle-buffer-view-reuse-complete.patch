+    ANGLE_GL_PROGRAM(program, essl31_shaders::vs::Simple(), fragment);
+    {
+        GLTexture texture;
+        GLBuffer buffer;
+        const std::array<GLfloat, 4> red = {1, 0, 0, 1};
+        glBindBuffer(GL_TEXTURE_BUFFER, buffer);
+        glBufferData(GL_TEXTURE_BUFFER, sizeof(red), red.data(), GL_DYNAMIC_DRAW);
+        glBindTexture(GL_TEXTURE_BUFFER, texture);
+        glTexBufferEXT(GL_TEXTURE_BUFFER, GL_RGBA32F, buffer);
+        drawQuad(program, essl31_shaders::PositionAttrib(), 0.5);
+        EXPECT_GL_NO_ERROR();
+    }
+    EXPECT_PIXEL_COLOR_EQ(0, 0, GLColor::red);
