+bool TextureVk::canRetainBufferViews(ContextVk *contextVk, VkDeviceSize offset,
+                                    VkDeviceSize size) const
+{
+    vk::Renderer *renderer = contextVk->getRenderer();
+    if (!renderer->getFeatures().tftmacRetainTextureBufferViews.enabled ||
+        !mTextureBufferViewKeyValid || !mBufferViews.isInitialized() ||
+        mState.getBuffer().get() == nullptr ||
+        NeedsRGBAEmulation(renderer, getBaseLevelFormat(renderer).getIntendedFormatID()))
+    {
+        return false;
+    }
+    BufferVk *bufferVk = vk::GetImpl(mState.getBuffer().get());
+    if (!bufferVk->isBufferValid())
+    {
+        return false;
+    }
+    const vk::BufferHelper &buffer = bufferVk->getBuffer();
+    return mTextureBufferViewGeneration == buffer.getBufferSerial() &&
+           mTextureBufferViewDevice == contextVk->getDevice() &&
+           mTextureBufferViewBuffer == buffer.getBuffer().getHandle() &&
+           mTextureBufferViewAllocationOffset == buffer.getOffset() &&
+           mTextureBufferViewBindingOffset == offset && mTextureBufferViewSize == size &&
+           mTextureBufferViewFormat == mState.getBaseLevelDesc().format.info->sizedInternalFormat;
+}
