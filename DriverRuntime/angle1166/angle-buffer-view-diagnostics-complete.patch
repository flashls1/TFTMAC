+// Diagnostic-only bounded guest-clock observations. Context/swap IDs are not
+// submission IDs or Android/native presentation IDs.
+struct TFTMACViewDiagnostics
+{
+    struct Span { uint64_t request, start, duration, offset, range; uint32_t format; };
+    inline static std::atomic<uint64_t> nextContext{1};
+    const uint64_t context = nextContext.fetch_add(1, std::memory_order_relaxed);
+    const bool enabled = [] {
+#if defined(__ANDROID__)
+        char value[PROP_VALUE_MAX] = {};
+        return __system_property_get("debug.angle.tftmac_view_stats", value) > 0 && value[0] == '1';
+#else
+        return false;
+#endif
+    }();
+    uint64_t frame = 0, request = 0, creates = 0, createNS = 0, hits = 0;
+    uint64_t unchanged = 0, allocation = 0, range = 0, format = 0, other = 0;
+    uint64_t previousBindings = 0, previousSyncs = 0, previousInvalidations = 0;
+    uint64_t lost = 0, count = 0;
+    std::array<Span, 512> spans{};
+    static uint64_t now()
+    {
+        timespec t{};
+        if (clock_gettime(CLOCK_MONOTONIC, &t) != 0) return 0;
+        return uint64_t(t.tv_sec) * 1000000000ull + uint64_t(t.tv_nsec);
+    }
+    void created(uint64_t started, const VkBufferViewCreateInfo &info)
+    {
+        const uint64_t ended = now();
+        ++request; ++creates;
+        const uint64_t duration = ended >= started ? ended - started : 0;
+        createNS += duration;
+        if (started == 0 || ended == 0 || count == spans.size()) { ++lost; return; }
+        spans[count++] = {request, started, duration, info.offset, info.range, uint32_t(info.format)};
+    }
+    void flush(uint64_t bindings, uint64_t syncs, uint64_t invalidations, bool reuse)
+    {
+        if (!enabled) return;
+        ++frame;
+#if defined(__ANDROID__)
+        __android_log_print(ANDROID_LOG_INFO, "TFTMAC_VIEW", "F 1 %llu %llu %llu %u %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu",
+            (unsigned long long)context, (unsigned long long)frame, (unsigned long long)now(), unsigned(reuse),
+            (unsigned long long)(bindings - previousBindings), (unsigned long long)(syncs - previousSyncs),
+            (unsigned long long)(invalidations - previousInvalidations), (unsigned long long)creates,
+            (unsigned long long)createNS, (unsigned long long)hits, (unsigned long long)unchanged,
+            (unsigned long long)allocation, (unsigned long long)range, (unsigned long long)format,
+            (unsigned long long)other, (unsigned long long)count, (unsigned long long)lost);
+        // Each line stays below Android's log payload bound. Explicit context,
+        // frame, chunk and total record counts detect truncation or logcat loss.
+        char text[3500]; size_t used = 0; unsigned chunk = 0;
+        auto begin = [&] { used = size_t(snprintf(text, sizeof(text), "S 1 %llu %llu %u ",
+            (unsigned long long)context, (unsigned long long)frame, chunk++)); };
+        auto emit = [&] { __android_log_print(ANDROID_LOG_INFO, "TFTMAC_VIEW", "%s", text); };
+        begin();
+        for (uint64_t i = 0; i < count; ++i)
+        {
+            if (sizeof(text) - used < 180) { emit(); begin(); }
+            const auto &span = spans[i];
+            used += size_t(snprintf(text + used, sizeof(text) - used, "%llu,%llu,%llu,%u,%llu,%llu;",
+                (unsigned long long)span.request, (unsigned long long)span.start,
+                (unsigned long long)span.duration, span.format,
+                (unsigned long long)span.offset, (unsigned long long)span.range));
+        }
+        if (count) emit();
+#endif
+        previousBindings = bindings; previousSyncs = syncs; previousInvalidations = invalidations;
+        creates = createNS = hits = unchanged = allocation = range = format = other = lost = count = 0;
+    }
+};
